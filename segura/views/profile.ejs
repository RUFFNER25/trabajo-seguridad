<%- include('partials/header', { title: 'Perfil' }) %>
<section class="hero">
  <h1>Perfil · <%= profile.username %></h1>
</section>
<section class="panel">
  <% if (profile.avatar) { %>
    <img class="avatar" src="/uploads/<%= profile.avatar %>" alt="avatar" />
  <% } %>
  <form method="POST" action="/profile/email">
    <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
    <input type="hidden" name="user_id" value="<%= profile.id %>" />
    <label>Email</label>
    <input name="email" value="<%= profile.email %>" />
    <label>Bio</label>
    <textarea name="bio"><%= profile.bio %></textarea>
    <button type="submit">Guardar</button>
  </form>
</section>
<section class="panel">
  <h2>Avatar / documento</h2>
  <form method="POST" action="/profile/avatar" enctype="multipart/form-data">
    <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
    <label>Archivo (solo imágenes; nombre aleatorio en servidor)</label>
    <input type="file" name="avatar" required />
    <button type="submit">Subir</button>
  </form>
</section>
<%- include('partials/footer') %>
