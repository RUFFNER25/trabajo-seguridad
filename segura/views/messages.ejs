<%- include('partials/header', { title: 'Soporte' }) %>
<section class="hero">
  <h1>Mensajes a soporte</h1>
  <p>Canal público del laboratorio. El contenido se escapa al renderizar (anti-XSS).</p>
</section>
<section class="panel">
  <h2>Nuevo mensaje</h2>
  <form method="POST" action="/messages">
    <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
    <label>Mensaje</label>
    <textarea name="body" required></textarea>
    <button type="submit">Publicar</button>
  </form>
</section>
<section class="panel">
  <h2>Historial</h2>
  <% messages.forEach(m => { %>
    <div class="msg">
      <div class="meta"><%= m.username %> · <%= m.created_at %></div>
      <div><%= m.body %></div>
    </div>
  <% }) %>
</section>
<%- include('partials/footer') %>
