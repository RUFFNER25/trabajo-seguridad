<%- include('partials/header', { title: 'Cuenta' }) %>
<section class="hero">
  <h1>Cuenta #<%= account.id %> · <%= account.username %></h1>
  <p class="muted">Email: <%= account.email %></p>
</section>
<section class="panel">
  <h2>Saldo</h2>
  <p class="balance">$<%= Number(account.balance).toFixed(2) %></p>
</section>
<section class="panel">
  <h2>Movimientos</h2>
  <table>
    <thead><tr><th>Concepto</th><th>De</th><th>A</th><th>Monto</th><th>Fecha</th></tr></thead>
    <tbody>
      <% txs.forEach(t => { %>
        <tr>
          <td><%= t.concept %></td>
          <td><%= t.from_name || '—' %></td>
          <td><%= t.to_name || '—' %></td>
          <td>$<%= Number(t.amount).toFixed(2) %></td>
          <td><%= t.created_at %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('partials/footer') %>
